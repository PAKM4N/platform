		}
	}
}

# RECOGIDA PÚBLICA DE ESTADÍSTICAS
stats.mercamicro.es {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	@tracker {
		path /script.js
		method GET HEAD
	}

	handle @tracker {
		reverse_proxy umami:3000
	}

	@collect {
		path /api/send
		method POST OPTIONS
	}

	handle @collect {
		reverse_proxy umami:3000
	}

	handle {
		respond "Forbidden" 403
	}
}

# PANEL PRIVADO DE UMAMI
umami.mercamicro.es {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	tls internal

	@internal {
		remote_ip 192.168.15.0/24 172.22.121.0/24
	}

	handle @internal {
		reverse_proxy umami:3000
	}

	handle {
		respond "Forbidden" 403
	}
}

