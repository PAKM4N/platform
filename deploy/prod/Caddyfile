http://127.0.0.1 {
	respond /health "ok" 200
	respond "Not found" 404
}

presupuestos.mercamicro.es {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	@project_leads path /api/project-leads
	handle @project_leads {
		reverse_proxy mercamicro-presupuestos-api:3000 {
			health_uri /health
			lb_try_duration 3s
		}
	}

	handle {
		reverse_proxy mercamicro-presupuestos-budget-web:8080 {
			health_uri /health
			lb_try_duration 3s
		}
	}
}

