FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY public ./public
COPY servicios ./servicios
COPY vite.servicios.config.js ./vite.servicios.config.js
RUN npx vite build --config vite.servicios.config.js

FROM caddy:2.11.4-alpine
COPY deploy/servicios.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist-servicios /srv
EXPOSE 8080
