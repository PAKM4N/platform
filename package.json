    "@fontsource-variable/newsreader": "^5.3.0",
    "fastify": "^5.6.2",
    "lucide-react": "^1.28.0",
    "postgres": "^3.4.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "playwright-core": "^1.62.0",
    "vite": "^8.1.5"
