{
  "name": "mercamicro-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "build:presupuestos": "vite build --config vite.presupuestos.config.js",
    "build:sites": "vite build && node scripts/prepare-sites-build.mjs",
    "start": "vite preview --host 0.0.0.0",
    "start:api": "node server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "check:visual": "node scripts/visual-check.mjs",
    "test:api": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
