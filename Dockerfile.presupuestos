FROM node:22-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY public ./public
COPY presupuestos ./presupuestos
COPY src/project-catalog.js src/project-pricing.js ./src/
COPY vite.presupuestos.config.js ./vite.presupuestos.config.js
RUN npx vite build --config vite.presupuestos.config.js

FROM caddy:2.11.4-alpine
COPY deploy/web.Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/dist-presupuestos /srv
EXPOSE 8080
